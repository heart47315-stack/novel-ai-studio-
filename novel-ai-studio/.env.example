# Frontend variables must be prefixed with VITE_.
# Only use a Supabase Publishable key or legacy Anon key in frontend variables.
# Never put AI provider secrets or Supabase Secret/service_role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key